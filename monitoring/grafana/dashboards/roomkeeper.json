    {
      "type": "timeseries",
      "title": "Outbox events per second",
      "description": "Side effects (emails, refunds) through their Redis streams: sent to a stream, published once their consumer acted, claimed after sitting unacknowledged, and resent because a stream didn't deliver them in time. Claimed and resent stay near zero unless a consumer fails or Redis loses entries.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(roomkeeper_outbox_sent_total[$__rate_interval]))",
          "legendFormat": "sent",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(roomkeeper_outbox_published_total[$__rate_interval]))",
          "legendFormat": "published",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(roomkeeper_outbox_claimed_total[$__rate_interval]))",
          "legendFormat": "claimed",
          "range": true
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
